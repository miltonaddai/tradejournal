PORT=3001
# The app has no login. Keep the default loopback bind unless you need remote access
# (e.g. HOST=0.0.0.0 inside a container), and then only on a network you trust.
# HOST=127.0.0.1
FRONTEND_URL=http://localhost:5173

# Local JSON data store (default: backend/data/db.json). Use :memory: for no persistence.
# DATA_FILE=./data/db.json

# Folder of 1-minute OHLCV candle files served by /api/charts (default: ../sample-candlestick-data)
# CANDLE_DATA_DIR=../sample-candlestick-data
